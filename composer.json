{
    "name": "rapira/laravel",
    "description": "Laravel bridge for Rapira: classic, worker and dispatcher modes on top of Laravel Octane",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "rapira",
        "laravel",
        "octane",
        "worker",
        "server"
    ],
    "homepage": "https://github.com/rapira-rs/laravel",
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.4",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "laravel/octane": "^2.13",
        "rapira/contract": "^0.9",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "llm/skills": "^1.14",
        "rapira/testing": "^0.1.6",
        "spiral/code-style": "^2.3",
        "testo/assert": "^0.1.13",
        "testo/lifecycle": "^0.1.5",
        "testo/test": "^0.1.6",
        "testo/testo": "^0.10.48"
    },
    "autoload": {
        "psr-4": {
            "Rapira\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rapira\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "llm/skills": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rapira\\Laravel\\RapiraServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "test": "testo",
        "test:unit": "testo --suite=Unit",
        "test:feature": "testo --suite=Feature",
        "test:acceptance": "testo --suite=Acceptance"
    }
}
